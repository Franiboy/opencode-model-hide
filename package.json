{
  "name": "@franiboy/opencode-model-hide",
  "version": "0.1.6",
  "description": "OpenCode plugin: hide models from the picker with an in-TUI selector",
  "type": "module",
  "license": "MIT",
  "author": "Franiboy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Franiboy/opencode-model-hide.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "models",
    "tui"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "check": "npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
